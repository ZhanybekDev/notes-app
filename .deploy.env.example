# Copy to `.deploy.env` (git-ignored) and fill in. Read by ./deploy.sh.
#
# SERVER_PRIMARY is tried first, SERVER_FALLBACK second — typically a VPN address that works from
# anywhere, then a LAN address that only resolves at home.

SERVER_PRIMARY=user@100.x.y.z
SERVER_FALLBACK=user@192.168.x.y

# Directory on the server, relative to the login user's home. Optional; defaults to notes_app.
# REMOTE_DIR=notes_app
