# Production image: build the bundle, then serve it from nginx.
#
# The development `Dockerfile` runs `npm run dev` and is not a candidate for this — the Vite dev
# server ships unminified modules and an HMR websocket, and its `/api` proxy only exists in
# `vite.config.js`. Here nginx does the proxying instead (see `nginx.conf`).

FROM node:20-alpine AS build

WORKDIR /app

# package-lock.json is copied with the manifest so `npm ci` can honour it: it installs the exact
# tree the lockfile pins, and fails loudly if the two disagree, rather than silently resolving new
# versions at deploy time the way `npm install` would.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
