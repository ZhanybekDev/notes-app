DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/notes
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# Telegram reminders (optional). Leave TELEGRAM_BOT_TOKEN empty to disable the
# feature - the app and worker still start. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional: skip a getMe call by setting the bot username used for deep links.
TELEGRAM_BOT_USERNAME=
# How often the worker checks for due reminders.
REMINDER_INTERVAL_SECONDS=60
