DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/notes
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# Telegram reminders. Both are needed; leave empty to run without reminders.
# Create a bot with @BotFather: /newbot -> name -> username -> token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
