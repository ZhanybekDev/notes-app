# Template for the production `.env`, which lives on the server at ~/notes_app/.env and is never
# committed (see .gitignore). Copy it there, fill it in, and `chmod 600` it.
#
# Generate the two secrets — do not reuse the development values, which are in the repository:
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
#   JWT_SECRET=$(openssl rand -hex 32)

# Password for the bundled postgres container. Also interpolated into DATABASE_URL by
# docker-compose.prod.yml, so it is written once, here.
POSTGRES_PASSWORD=

# Signs session tokens. Settings.validate_jwt_secret rejects anything under 32 characters or on
# its list of placeholders, so the app refuses to start with a weak value rather than pretending
# to be secure. Changing it invalidates every issued session.
JWT_SECRET=

JWT_EXPIRE_MINUTES=1440

# Same-origin deployment: nginx serves the bundle and proxies /api to the backend, so the browser
# never makes a cross-origin request and this list is not consulted for normal traffic. Kept
# accurate anyway, because an empty value would be the wrong thing to inherit if that changes.
CORS_ORIGINS=https://notes.ssi-dev.com

# Telegram reminders. Both are required for the bot to work; leave empty to run without it.
# One process per token: while this worker runs, no local worker may poll the same bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
